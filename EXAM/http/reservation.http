### ============================================================
###  RESERVATION SERVICE (/api/reservations) - MSS301 SU26 PE1
###  Chon env "gateway" (8080).
###
###  BANG MA CUA DE NAY:
###    201 / status 1  create OK            200 / status 1  OK
###    406 / status 2  validation failed
###    404 / status 4  Room ID / Reservation ID is not found
###    400 / status 5  Room is not AVAILABLE for reservation   <-- CHI CO O CREATE
###    500 / status 0  internal error
###  LUU Y: bang Response Behavior cua UPDATE KHONG co dong 400/5.
###
###  QUY TAC NGHIEP VU PHAI DUNG:
###    - totalAmount = pricePerNight x SO DEM (ChronoUnit.DAYS giua 2 ngay). Server tu tinh,
###      client gui gi cung bi ghi de.
###    - numberOfGuests KHONG duoc vuot capacity cua room (goi RoomService lay capacity).
###    - checkOutDate phai SAU checkInDate.
###    - Ngay dung dd/MM/yyyy. GET /{id} va list tra ReservationDetailDTO (room NESTED).
###      POST va PUT tra ReservationDTO (roomId PHANG).
###
###  Truoc khi chay: sql\seed_test_db.sql
###    room 1 = A-101 DOUBLE 850000 capacity 2 AVAILABLE
###    room 2 = A-102 SINGLE 500000 capacity 1 AVAILABLE
###    room 3 = OCCUPIED, room 4 = MAINTENANCE
###    reservation 1..5, guestName co "Nguyen Van An" va "Hoang Van An"
### ============================================================


### ---------- V5. GET /api/reservations - Get Reservation List ----------

### V5.1 List mac dinh -> 200/1, PageDTO du 7 field
# BAY LON: de ghi "PageDTO: See the definition in Room Service section" -> phai dung
# size/page/totalPages/totalElements/first/last/content, KHONG duoc tu che DTO list rieng.
# Expect: size=10, page=0, totalElements=5
GET {{reservationUrl}}/api/reservations

### V5.2 content phai la ReservationDetailDTO
# Expect moi row: reservationId, guestName, guestEmail, guestPhone, checkInDate, checkOutDate,
#                 numberOfGuests, totalAmount, status, room (NESTED)
# KHONG duoc co roomId. status KHONG duoc null (bay: mapper quen setStatus).
GET {{reservationUrl}}/api/reservations?size=1

### V5.3 Ngay trong response dung dd/MM/yyyy
GET {{reservationUrl}}/api/reservations?size=1

### V5.4 Filter guestName partial match -> 2 row
GET {{reservationUrl}}/api/reservations?guestName=van an

### V5.5 guestName partial that su (khop giua chuoi) -> 4 row
# "an" nam trong Tran, Van, Hoang -> LIKE %an% phai ra 4.
GET {{reservationUrl}}/api/reservations?guestName=an

### V5.6 guestName khong khop -> 200/1, totalElements=0
# Neu tra du 5 row -> filter dang bi BO QUA (sai ten param).
GET {{reservationUrl}}/api/reservations?guestName=zzzznomatch

### V5.7 Filter status -> 2 row CONFIRMED
GET {{reservationUrl}}/api/reservations?status=CONFIRMED

### V5.8 status ngoai Enum -> 406/2
GET {{reservationUrl}}/api/reservations?status=BOGUS

### V5.9 size=101 -> 406/2
GET {{reservationUrl}}/api/reservations?size=101

### V5.10 size=0 -> 406/2
GET {{reservationUrl}}/api/reservations?size=0

### V5.11 page am -> 406/2
GET {{reservationUrl}}/api/reservations?page=-1

### V5.12 page sai kieu -> 406/2
GET {{reservationUrl}}/api/reservations?page=xyz


### ---------- V1. POST /api/reservations - Create Reservation ----------

### V1.1 Create hop le -> 201/1, status=CONFIRMED, totalAmount = 850000 x 4 dem = 3400000
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "Test Guest",
  "guestEmail": "guest@example.com",
  "guestPhone": "0912345678",
  "checkInDate": "01/08/2026",
  "checkOutDate": "05/08/2026",
  "numberOfGuests": 2,
  "roomId": 1
}

> {% client.global.set("reservationId", response.body.data.reservationId); %}

### V1.2 KHONG gui totalAmount van phai 201
# BAY: dat @NotNull len totalAmount thi moi request dung dac ta deu bi 406.
# Expect: 201/1, totalAmount = 500000 x 2 = 1000000
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "No Amount",
  "guestEmail": "na@example.com",
  "guestPhone": "0912345679",
  "checkInDate": "10/08/2026",
  "checkOutDate": "12/08/2026",
  "numberOfGuests": 1,
  "roomId": 2
}

### V1.3 Client gui totalAmount bay -> server phai TINH LAI
# Expect: 201/1, totalAmount = 1000000 (KHONG phai 1)
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "Fake Amount",
  "guestEmail": "fa@example.com",
  "guestPhone": "0912345680",
  "checkInDate": "10/08/2026",
  "checkOutDate": "12/08/2026",
  "numberOfGuests": 1,
  "totalAmount": 1,
  "roomId": 2
}

### V1.4 roomId khong ton tai -> 404/4 "Room ID is not found"
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "Ghost Room", "guestEmail": "gr@example.com", "guestPhone": "0912345681",
  "checkInDate": "01/08/2026", "checkOutDate": "03/08/2026", "numberOfGuests": 1, "roomId": 999999
}

### V1.5 Room dang OCCUPIED -> 400/5 "Room is not AVAILABLE for reservation"
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "Occupied", "guestEmail": "oc@example.com", "guestPhone": "0912345682",
  "checkInDate": "01/08/2026", "checkOutDate": "03/08/2026", "numberOfGuests": 1, "roomId": 3
}

### V1.6 Room dang MAINTENANCE -> 400/5
# De ghi ro: "A room in MAINTENANCE cannot be reserved."
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "Maint", "guestEmail": "mt@example.com", "guestPhone": "0912345683",
  "checkInDate": "01/08/2026", "checkOutDate": "03/08/2026", "numberOfGuests": 1, "roomId": 4
}

### V1.7 numberOfGuests VUOT capacity cua room -> 406/2
# room 1 capacity = 2, gui 5 khach. "Must not exceed the room capacity".
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "Too Many", "guestEmail": "tm@example.com", "guestPhone": "0912345684",
  "checkInDate": "01/08/2026", "checkOutDate": "03/08/2026", "numberOfGuests": 5, "roomId": 1
}

### V1.8 numberOfGuests = DUNG capacity -> 201/1 (bien tren hop le)
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "Exact Cap", "guestEmail": "ec@example.com", "guestPhone": "0912345685",
  "checkInDate": "01/08/2026", "checkOutDate": "03/08/2026", "numberOfGuests": 2, "roomId": 1
}

### V1.9 checkOutDate = checkInDate -> 406/2 (CK_Reservations_Dates: phai LON HON)
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "Same Day", "guestEmail": "sd@example.com", "guestPhone": "0912345686",
  "checkInDate": "01/08/2026", "checkOutDate": "01/08/2026", "numberOfGuests": 1, "roomId": 1
}

### V1.10 checkOutDate TRUOC checkInDate -> 406/2
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "Reverse", "guestEmail": "rv@example.com", "guestPhone": "0912345687",
  "checkInDate": "05/08/2026", "checkOutDate": "01/08/2026", "numberOfGuests": 1, "roomId": 1
}

### V1.11 Ngay sai format (ISO) -> 406/2
# De ghi ro "The accepted format dd/MM/yyyy" -> ISO phai bi tu choi.
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "Bad Fmt", "guestEmail": "bf@example.com", "guestPhone": "0912345688",
  "checkInDate": "2026-08-01", "checkOutDate": "05/08/2026", "numberOfGuests": 1, "roomId": 1
}

### V1.12 Ngay khong ton tai (31/02) -> 406/2 (ResolverStyle.STRICT)
POST {{reservationUrl}}/api/reservations
Content-Type: application/json

{
  "guestName": "Bad Day", "guestEmail": "bd@example.com", "guestPhone": "0912345689",
  "checkInDate": "31/02/2026", "checkOutDate": "05/08/2026", "numberOfGuests": 1, "roomId": 1
}

